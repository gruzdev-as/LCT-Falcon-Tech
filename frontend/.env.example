# Copy to .env.local to deviate. VITE_* is inlined at build time.

# --- API ---------------------------------------------------------------------
# Relative on purpose: the dev proxy and nginx both resolve it. Never make it absolute.
VITE_API_BASE=/api/v1

# --- Demo --------------------------------------------------------------------
# Fixture results instead of the real API.
# Append ?demo=found|rejected|failed|timeout to pick a scenario.
VITE_DEMO_MODE=false
