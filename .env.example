# Скопировать в .env и поправить. У всего есть рабочий дефолт для localhost,
# так что .env нужен, только чтобы от него отступить.

# --- Redis (шина задач) ------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=10

# --- Объектное хранилище (RustFS, S3-совместимое) -----------------------------
S3_ENDPOINT_URL=http://localhost:9000
# Адрес для подписи ссылок в браузер: внутри компоуза это rustfs, в браузере - localhost
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET=falcon-images
S3_PRESIGN_TTL=3600

# --- Qdrant (векторный поиск, принадлежит inference) --------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Postgres (метаданные) ----------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=falcon
POSTGRES_PASSWORD=falcon
POSTGRES_DB=falcon
POSTGRES_POOL_SIZE=10
# Логировать каждый SQL-запрос в stdout; только для отладки
POSTGRES_ECHO=false
# Перекрывает всё, что выше; нужен одноразовым тестовым базам
POSTGRES_DSN=
# Отдельная одноразовая база для `pytest -m integration`; без неё такие тесты пропускаются
POSTGRES_TEST_DSN=

# --- Галерея ------------------------------------------------------------------
# Монтируется всегда: в каталоге manifest.csv и images/.
# Колонки манифеста: image_id,image_path,vehicle_id,camera_id,bbox_x,bbox_y,bbox_width,bbox_height;
# image_path — относительно images/, bbox обязателен у каждой строки
GALLERY_DIR=./data/gallery

# --- Bootstrap (одноразовый сервис init) --------------------------------------
# Веса и CatBoost — прямые ссылки; эмбеддинги галереи считают воркеры inference
INIT_MODEL_URL=https://huggingface.co/lightsource/eva_mad_model/resolve/main/eva02.pt
INIT_MODEL_SHA256=1bd827fd855f4f480a888188dc7fe224d38b3d4799a6e33a180682044683f40d
# CatBoost поверх эмбеддингов, из того же репозитория, кладётся рядом с весами
INIT_CATBOOST_URL=https://huggingface.co/lightsource/eva_mad_model/resolve/main/eva02_catboost.cbm
INIT_CATBOOST_SHA256=3cf5c9ad358f10e9aa628d68ad836cef0051c2a6d7293743eaac20d60dde4063
# Read-токен Hugging Face для закрытого репозитория; уходит только на huggingface.co
INIT_HF_TOKEN=

# Только для локального запуска init через uv; в компоузе это монтирования /gallery и /weights
INIT_GALLERY_DIR=data/gallery
INIT_WEIGHTS_DIR=data/weights
# Перезалить картинки и пересчитать всю галерею; то же, что docker compose run --rm init --force
INIT_FORCE=false
INIT_UPLOAD_CONCURRENCY=16

# gallery-ready: как часто проверять прогресс, через сколько секунд без прогресса предупреждать,
# и через сколько сдаться (0 — ждать сколько угодно: на CPU галерея считается долго)
INIT_WAIT_POLL_S=5
INIT_WAIT_STALL_S=300
INIT_WAIT_TIMEOUT_S=0

# --- Воркер inference ---------------------------------------------------------
# Serving-чекпоинт, который init скачал по INIT_MODEL_URL; в компоузе /weights смонтирован read-only
INFERENCE_WEIGHTS_PATH=/weights/eva02.pt
# auto — cuda, если есть, иначе cpu. GPU в компоузе: -f docker-compose.gpu.yaml
INFERENCE_DEVICE=auto
# torch.compile: только на cuda, долгий прогрев на старте
INFERENCE_COMPILE=false
# Потоков torch на реплику на CPU; 0 — по умолчанию torch (реплики будут драться за ядра)
INFERENCE_TORCH_THREADS=0
# Режим отказа (пустая выдача с rejected=true) — пресет training с порогами под текущие веса.
# eva02_ensemble: принять, только если и косинус, и CatBoost-голова согласны (так отдаёт training)
INFERENCE_REFUSAL_CONFIG=training/configs/refusal/eva02_ensemble.yaml
# CatBoost-голова, которую init скачал по INIT_CATBOOST_URL; нужна пресетам model и ensemble
INFERENCE_REFUSAL_MODEL_PATH=/weights/eva02_catboost.cbm
# Override: отказ по одному косинусу с этим порогом, пресет игнорируется. Пусто — работает пресет
INFERENCE_REJECT_THRESHOLD=
# Должно быть меньше REDIS_SOCKET_TIMEOUT (секунды), иначе холостые чтения отваливаются
INFERENCE_BLOCK_MS=2000
# Задача, провисевшая столько, считается брошенной упавшей репликой и забирается
INFERENCE_CLAIM_IDLE_MS=60000
INFERENCE_CLAIM_INTERVAL_S=15
# Сколько попыток, прежде чем «ядовитую» задачу окончательно пометить failed
INFERENCE_MAX_DELIVERIES=3
# Только для компоуза: число реплик. Каждая держит в памяти свою копию модели (~1.2 ГБ)
INFERENCE_REPLICAS=1

# --- Backend ------------------------------------------------------------------
APP_TITLE=FastAPI server for LCT

# --- Frontend -----------------------------------------------------------------
# Порт nginx; SPA и проксируемый API живут на одном origin
FRONTEND_PORT=8080
# Фикстуры вместо настоящего API; вшивается на сборке, нужен docker compose build frontend
VITE_DEMO_MODE=false

# --- Общее --------------------------------------------------------------------
LOG_LEVEL=INFO
