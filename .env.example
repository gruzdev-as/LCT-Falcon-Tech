# Copy to .env and adjust. Every variable below has a working default for a
# localhost setup, so .env is only needed to deviate from it.

# --- Redis (task bus) --------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=10

# --- Object storage (RustFS, S3-compatible) ----------------------------------
S3_ENDPOINT_URL=http://localhost:9000
# Address used to sign links handed to the browser. Inside compose the backend
# talks to http://rustfs:9000, but the browser can only resolve localhost.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET=falcon-images
S3_PRESIGN_TTL=3600

# --- Qdrant (vector search, owned by inference) ------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Inference worker --------------------------------------------------------
# Embedding backend; only `stub` exists until a trained model lands
INFERENCE_EMBEDDER=stub
INFERENCE_EMBEDDING_DIM=512
# Best score below this gives an empty result with rejected=true
INFERENCE_REJECT_THRESHOLD=0.5
# Must stay below REDIS_SOCKET_TIMEOUT (seconds), or idle reads time out
INFERENCE_BLOCK_MS=2000
# A task pending this long is considered abandoned by a dead replica and reclaimed
INFERENCE_CLAIM_IDLE_MS=60000
INFERENCE_CLAIM_INTERVAL_S=15
# Attempts before a task that keeps crashing workers is failed for good
INFERENCE_MAX_DELIVERIES=3
# Compose only: number of worker replicas, and the dependency group baked into
# the image (`inference` pulls torch, needed once a real model replaces the stub)
INFERENCE_REPLICAS=2
INFERENCE_DEPS_GROUP=common

# --- Backend -----------------------------------------------------------------
APP_TITLE=FastAPI server for LCT

# --- Frontend ----------------------------------------------------------------
# Port nginx is published on; the SPA and the proxied API share this one origin.
FRONTEND_PORT=8080
# Fixture results instead of the real API. Inlined at build time, so changing it
# needs `docker compose build frontend`.
VITE_DEMO_MODE=false

# --- Shared ------------------------------------------------------------------
LOG_LEVEL=INFO
