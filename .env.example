# Скопировать в .env и поправить. У всего есть рабочий дефолт для localhost,
# так что .env нужен, только чтобы от него отступить.

# --- Redis (шина задач) ------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=10

# --- Объектное хранилище (RustFS, S3-совместимое) -----------------------------
S3_ENDPOINT_URL=http://localhost:9000
# Адрес для подписи ссылок в браузер: внутри компоуза это rustfs, в браузере - localhost
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET=falcon-images
S3_PRESIGN_TTL=3600

# --- Qdrant (векторный поиск, принадлежит inference) --------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Postgres (метаданные) ----------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=falcon
POSTGRES_PASSWORD=falcon
POSTGRES_DB=falcon
POSTGRES_POOL_SIZE=10
# Перекрывает всё, что выше; нужен одноразовым тестовым базам
POSTGRES_DSN=

# --- Bootstrap (одноразовый сервис init) --------------------------------------
# Три артефакта, три ссылки
# Ссылка - прямая, без авторизации.
INIT_MODEL_URL=
INIT_MODEL_SHA256=
# Архив с картинками. Картинки лежат в корне архива, без папки-обёртки, а иначе манифест их не найдёт
INIT_IMAGES_URL=
INIT_IMAGES_SHA256=
# Архив, в корне которого bundle.json, embeddings.npy и manifest.csv
INIT_VECTORS_URL=
INIT_VECTORS_SHA256=

# Куда всё кладётся; в компоузе это монтирования /artifacts и /weights
INIT_ARTIFACTS_DIR=data/gallery
INIT_WEIGHTS_DIR=data/weights
# Перекачать и пересобрать; то же, что docker compose run --rm init --force
INIT_FORCE=false
INIT_UPLOAD_CONCURRENCY=16
INIT_UPSERT_BATCH=256

# --- Воркер inference ---------------------------------------------------------
# Бэкенд эмбеддингов; пока есть только stub
INFERENCE_EMBEDDER=stub
# Должно совпадать с embedding_dim из bundle.json, иначе воркер упадёт на старте
INFERENCE_EMBEDDING_DIM=512
# Лучший скор ниже этого даёт пустую выдачу с rejected=true
INFERENCE_REJECT_THRESHOLD=0.5
# Должно быть меньше REDIS_SOCKET_TIMEOUT (секунды), иначе холостые чтения отваливаются
INFERENCE_BLOCK_MS=2000
# Задача, провисевшая столько, считается брошенной упавшей репликой и забирается
INFERENCE_CLAIM_IDLE_MS=60000
INFERENCE_CLAIM_INTERVAL_S=15
# Сколько попыток, прежде чем «ядовитую» задачу окончательно пометить failed
INFERENCE_MAX_DELIVERIES=3
# Только для компоуза: число реплик и группа зависимостей в образе (inference тянет torch)
INFERENCE_REPLICAS=2
INFERENCE_DEPS_GROUP=common

# --- Backend ------------------------------------------------------------------
APP_TITLE=FastAPI server for LCT

# --- Frontend -----------------------------------------------------------------
# Порт nginx; SPA и проксируемый API живут на одном origin
FRONTEND_PORT=8080
# Фикстуры вместо настоящего API; вшивается на сборке, нужен docker compose build frontend
VITE_DEMO_MODE=false

# --- Общее --------------------------------------------------------------------
LOG_LEVEL=INFO
